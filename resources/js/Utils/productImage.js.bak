            'https://images.unsplash.com/photo-1586864387967-d02ef85d93e8?auto=format&fit=crop&w=600&q=80',
            'https://images.unsplash.com/photo-1581783342308-f792dbdd27c5?auto=format&fit=crop&w=600&q=80',
            'https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&w=600&q=80',
        ],
    },
    {
        keywords: ['plomeria', 'tuberia'],
        images: [
            'https://images.unsplash.com/photo-1607472586893-edb57bdc0e39?auto=format&fit=crop&w=600&q=80',
            'https://images.unsplash.com/photo-1584622650111-993a426fbf0a?auto=format&fit=crop&w=600&q=80',
            'https://images.unsplash.com/photo-1585771724684-38269d6639fd?auto=format&fit=crop&w=600&q=80',
        ],
    },
];

const DEFAULT_IMAGES = [
    'https://images.unsplash.com/photo-1586864387967-d02ef85d93e8?auto=format&fit=crop&w=600&q=80',
    'https://images.unsplash.com/photo-1581783342308-f792dbdd27c5?auto=format&fit=crop&w=600&q=80',
    'https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&w=600&q=80',
    'https://images.unsplash.com/photo-1581244277943-fe4a9c777189?auto=format&fit=crop&w=600&q=80',
];

/**
 * Normaliza una cadena removiendo acentos y caracteres diacríticos.
 */
function normalizeText(text) {
    if (!text || typeof text !== 'string') return '';
    return text
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .trim();
}

/**
 * Genera un número entero positivo determinista a partir de los atributos del producto.
 */
function getProductHash(product) {
    const seed = `${product?.id ?? ''}-${product?.codigo_sku ?? ''}-${product?.nombre ?? ''}`;
    let hash = 0;
    for (let i = 0; i < seed.length; i++) {
        hash = (hash << 5) - hash + seed.charCodeAt(i);
        hash |= 0;
    }
    return Math.abs(hash);
}

/**
 * Obtiene la imagen adecuada para un producto:
 * 1. Prioriza la imagen subida en BD (disco public).
 * 2. Si no tiene foto propia, busca la colección por palabras clave en el nombre.
 * 3. Usa un hash para seleccionar una foto de la colección garantizando variedad entre productos similares.
 * 4. Si no coincide el nombre, busca por categoría.
 * 5. Fallback a imagen de herramientas de ferretería.
 *
 * @param {object} product - Objeto del producto
 * @returns {string} URL de la imagen
 */
export function getProductImage(product) {
    if (!product) return DEFAULT_IMAGES[0];

    // 1. Imagen propia subida por el usuario
    if (product.imagen_url && typeof product.imagen_url === 'string' && product.imagen_url.trim() !== '') {
        return product.imagen_url;
    }
    if (product.imagen && typeof product.imagen === 'string' && product.imagen.trim() !== '') {
        return product.imagen.startsWith('http')
            ? product.imagen
            : `/storage/${product.imagen.replace(/^\/+/, '')}`;
    }

    const hash = getProductHash(product);
    const nombreNormalizado = normalizeText(product.nombre);

    // 2. Coincidencia específica por palabras clave en el nombre
    for (const entry of PRODUCT_IMAGE_COLLECTIONS) {
        const matches = entry.keywords.some((kw) =>
            nombreNormalizado.includes(normalizeText(kw)),
        );
        if (matches && entry.images.length > 0) {
            const index = hash % entry.images.length;
            return entry.images[index];
        }
    }

    // 3. Coincidencia por categoría del producto
    const categoriaNormalizada = normalizeText(
        typeof product.categoria === 'string'
            ? product.categoria
            : product.categoria?.nombre || '',
    );

    if (categoriaNormalizada) {
        for (const entry of CATEGORY_FALLBACK_COLLECTIONS) {
            const matches = entry.keywords.some((kw) =>
                categoriaNormalizada.includes(normalizeText(kw)),
            );
            if (matches && entry.images.length > 0) {
                const index = hash % entry.images.length;
                return entry.images[index];
            }
        }
    }

    // 4. Fallback determinista general de ferretería
    return DEFAULT_IMAGES[hash % DEFAULT_IMAGES.length];
}
